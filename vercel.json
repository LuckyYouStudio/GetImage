{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/v1/:path*",     "destination": "/api/proxy?p=/v1/:path*" },
    { "source": "/v1beta/:path*", "destination": "/api/proxy?p=/v1beta/:path*" },
    { "source": "/api/v1/keys",   "destination": "/api/proxy?p=/api/v1/keys" }
  ],
  "functions": {
    "api/proxy.js": { "maxDuration": 300 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
